# Environment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/seferbaklik"
AUTH_SECRET="replace-with-long-random-secret"
PLATFORM_USERNAME="admin"
PLATFORM_PASSWORD="replace-with-strong-password"
DEMO_BARBER_PASSWORD="barber123"

# SMS (Twilio) — optional locally; without these, SMS is skipped
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+1234567890"

# Cron reminders — required on Render for reminder SMS
CRON_SECRET="replace-with-random-secret"
APP_URL="https://sefer-baklik.onrender.com"
