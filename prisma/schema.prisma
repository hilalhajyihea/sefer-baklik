generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barber {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  displayName             String
  username                String   @unique
  passwordHash            String
  isActive                Boolean  @default(true)
  slotMinutes             Int      @default(30)
  /// Platform admin: allows this barber to use SMS features
  smsPlanEnabled          Boolean  @default(false)
  /// Platform admin: include self-cancel link in customer SMS
  customerCancelEnabled   Boolean  @default(false)
  /// Public + barber UI + SMS language: he | ar
  locale                  String   @default("he")
  smsConfirmationEnabled  Boolean  @default(true)
  smsReminderEnabled      Boolean  @default(true)
  reminderMinutesBefore   Int      @default(30)
  /// Barber mobile for SMS alerts (e.g. customer cancelled)
  phone                   String?
  /// Notify barber by SMS when a customer self-cancels
  notifyOnCustomerCancel  Boolean  @default(true)
  /// Platform-set monthly SMS allowance (resets remaining on the 1st, Israel time)
  smsQuota                Int      @default(0)
  /// Remaining customer SMS sends this month (1 per successful send)
  smsRemaining            Int      @default(0)
  /// True after low-quota (≤10) alert was sent; cleared on monthly reset / top-up above 10
  smsLowNotified          Boolean  @default(false)
  /// YYYY-MM (Asia/Jerusalem) of the last monthly quota reset
  smsQuotaMonth           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workingHours      WorkingHours[]
  dayOffs           DayOff[]
  appointments      Appointment[]
  staff             Staff[]
  recurringSeries   RecurringSeries[]
}

model WorkingHours {
  id        String @id @default(cuid())
  barberId  String
  /// 0 = Sunday … 6 = Saturday (Israel week)
  dayOfWeek Int
  startTime String
  endTime   String

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

model DayOff {
  id       String   @id @default(cuid())
  barberId String
  date     DateTime @db.Date
  note     String?

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, date])
  @@index([barberId])
}

model Staff {
  id          String   @id @default(cuid())
  barberId    String
  displayName String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barber       Barber              @relation(fields: [barberId], references: [id], onDelete: Cascade)
  workingHours StaffWorkingHours[]
  dayOffs      StaffDayOff[]
  appointments Appointment[]

  @@index([barberId])
  @@index([barberId, isActive])
}

model StaffWorkingHours {
  id        String @id @default(cuid())
  staffId   String
  /// 0 = Sunday … 6 = Saturday (Israel week)
  dayOfWeek Int
  startTime String
  endTime   String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model StaffDayOff {
  id      String   @id @default(cuid())
  staffId String
  date    DateTime @db.Date
  note    String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId])
}

model Appointment {
  id                 String    @id @default(cuid())
  barberId           String
  /// Set in team mode (2+ active staff); null for solo shops
  staffId            String?
  seriesId           String?
  startsAt           DateTime
  endsAt             DateTime
  customerName       String
  customerPhone      String
  /// BOOKED | CANCELLED
  status             String    @default("BOOKED")
  /// PUBLIC | ADMIN | RECURRING
  source             String    @default("PUBLIC")
  /// Opaque token for customer self-cancel link in SMS (nullable so existing rows can migrate)
  cancelToken        String?
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  barber Barber           @relation(fields: [barberId], references: [id], onDelete: Cascade)
  staff  Staff?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  series RecurringSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([barberId, startsAt])
  @@index([barberId, status])
  @@index([staffId, startsAt])
  @@index([seriesId])
  @@index([status, reminderSentAt, startsAt])
  @@index([cancelToken])
}

/// Admin-created repeating bookings for a specific customer
model RecurringSeries {
  id            String    @id @default(cuid())
  barberId      String
  staffId       String?
  customerName  String
  customerPhone String
  /// WEEKLY | BIWEEKLY | TRIWEEKLY | MONTHLY
  interval      String
  /// HH:mm
  time          String
  /// First occurrence YYYY-MM-DD (Jerusalem)
  startDateKey  String
  /// Last occurrence YYYY-MM-DD (inclusive)
  endDateKey    String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  barber       Barber        @relation(fields: [barberId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([barberId])
}
